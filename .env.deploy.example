# Copy to .env.deploy and fill in. .env.deploy is gitignored.
VPS_HOST=your.vps.ip.or.host
VPS_USER=youruser
SSH_PORT=2222
GHCR_USER=connor93
GHCR_PAT=ghp_xxxxxxxxxxxxxxxxxxxx        # GHCR token (write:packages)
EDITOR_DOMAIN=editor.origin-project.net

# Optional: path to reoserv/data/gfx (the extracted PNG tree). When set, the
# deploy seeds the origin-gfx volume (~30M, once) so the editor's form preview
# thumbnails render. Leave blank to skip GFX previews.
GFX_SRC=/Users/cfraser/Projects/reoserv/data/gfx
