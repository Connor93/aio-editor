{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aio-editor/schemas/spells.json",
  "title": "Spell",
  "description": "REOSERV data/pub/spells/<id>.json — one EsfRecord per file. See src/utils/load_spell_file.rs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "x-aio-groups": [
    {
      "label": "Identity",
      "fields": ["name", "chant", "icon_id", "graphic_id"]
    },
    {
      "label": "Cast",
      "fields": ["tp_cost", "sp_cost", "cast_time"]
    },
    {
      "label": "Behavior",
      "fields": ["nature", "type", "target_restrict", "target_type", "target_time", "max_skill_level"]
    },
    {
      "label": "Combat",
      "fields": ["min_damage", "max_damage", "accuracy", "evade", "armor", "return_damage"]
    },
    {
      "label": "Element",
      "fields": ["element", "element_power"]
    },
    {
      "label": "Heal",
      "layout": "inline",
      "fields": ["hp_heal", "tp_heal", "sp_heal"]
    },
    {
      "label": "Stat Buffs",
      "layout": "inline",
      "fields": ["str", "intl", "wis", "agi", "con", "cha"]
    }
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "chant": { "type": "string", "description": "Spoken chant string shown in-game when cast." },
    "icon_id": {
      "type": "integer",
      "minimum": 0,
      "x-aio-display": { "kind": "gfx", "category": "spell_icons" }
    },
    "graphic_id": {
      "type": "integer",
      "minimum": 0,
      "x-aio-display": { "kind": "gfx", "category": "spells" }
    },
    "tp_cost": { "type": "integer", "minimum": 0 },
    "sp_cost": { "type": "integer", "minimum": 0 },
    "cast_time": { "type": "integer", "minimum": 0 },
    "nature": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillNature enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "Spell" },
        { "value": 1, "label": "Skill" }
      ]
    },
    "type": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillType enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "Heal" },
        { "value": 1, "label": "Attack" },
        { "value": 2, "label": "Bard" }
      ]
    },
    "element": {
      "type": "integer",
      "minimum": 0,
      "description": "Element enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "None" },
        { "value": 1, "label": "Light" },
        { "value": 2, "label": "Dark" },
        { "value": 3, "label": "Earth" },
        { "value": 4, "label": "Wind" },
        { "value": 5, "label": "Water" },
        { "value": 6, "label": "Fire" }
      ]
    },
    "element_power": { "type": "integer", "minimum": 0 },
    "target_restrict": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillTargetRestrict enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "NPC only" },
        { "value": 1, "label": "Friendly" },
        { "value": 2, "label": "Opponent" }
      ]
    },
    "target_type": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillTargetType enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "Normal" },
        { "value": 1, "label": "Self" },
        { "value": 3, "label": "Group" }
      ]
    },
    "target_time": { "type": "integer", "minimum": 0 },
    "max_skill_level": { "type": "integer", "minimum": 0 },
    "min_damage": { "type": "integer", "minimum": 0 },
    "max_damage": { "type": "integer", "minimum": 0 },
    "accuracy": { "type": "integer" },
    "evade": { "type": "integer" },
    "armor": { "type": "integer" },
    "return_damage": { "type": "integer" },
    "hp_heal": { "type": "integer", "minimum": 0 },
    "tp_heal": { "type": "integer", "minimum": 0 },
    "sp_heal": { "type": "integer", "minimum": 0 },
    "str": { "type": "integer" },
    "intl": { "type": "integer" },
    "wis": { "type": "integer" },
    "agi": { "type": "integer" },
    "con": { "type": "integer" },
    "cha": { "type": "integer" }
  }
}
