{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aio-editor/schemas/spells.json",
  "title": "Spell",
  "description": "REOSERV data/pub/spells/<id>.json — one EsfRecord per file. See src/utils/load_spell_file.rs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "chant": { "type": "string", "description": "Spoken chant string shown in-game when cast." },
    "icon_id": { "type": "integer", "minimum": 0 },
    "graphic_id": { "type": "integer", "minimum": 0 },
    "tp_cost": { "type": "integer", "minimum": 0 },
    "sp_cost": { "type": "integer", "minimum": 0 },
    "cast_time": { "type": "integer", "minimum": 0 },
    "nature": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillNature enum (eolib): damage/heal/cure/stat-buff/etc."
    },
    "type": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillType enum (eolib)."
    },
    "element": {
      "type": "integer",
      "minimum": 0,
      "description": "Element enum (eolib): 0=None,1=Light,2=Dark,3=Earth,4=Air,5=Water,6=Fire."
    },
    "element_power": { "type": "integer", "minimum": 0 },
    "target_restrict": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillTargetRestrict enum: 0=NPCOnly,1=Friendly,2=Opponent."
    },
    "target_type": {
      "type": "integer",
      "minimum": 0,
      "description": "SkillTargetType enum: 0=Normal,1=Self,2=Group,3=Area."
    },
    "target_time": { "type": "integer", "minimum": 0 },
    "max_skill_level": { "type": "integer", "minimum": 0 },
    "min_damage": { "type": "integer", "minimum": 0 },
    "max_damage": { "type": "integer", "minimum": 0 },
    "accuracy": { "type": "integer" },
    "evade": { "type": "integer" },
    "armor": { "type": "integer" },
    "return_damage": { "type": "integer" },
    "hp_heal": { "type": "integer", "minimum": 0 },
    "tp_heal": { "type": "integer", "minimum": 0 },
    "sp_heal": { "type": "integer", "minimum": 0 },
    "str": { "type": "integer" },
    "intl": { "type": "integer" },
    "wis": { "type": "integer" },
    "agi": { "type": "integer" },
    "con": { "type": "integer" },
    "cha": { "type": "integer" }
  }
}
