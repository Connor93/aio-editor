{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aio-editor/schemas/npcs.json",
  "title": "NPC",
  "description": "REOSERV data/pub/npcs/<id>.json — one record per file. Combines EnfRecord plus drop, talk, and per-NPC rate overrides (drops loaded by src/utils/load_drop_file.rs, talk by load_talk_file.rs, rates by load_npc_rates_file.rs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "x-aio-groups": [
    {
      "label": "Identity",
      "fields": ["name", "graphic_id", "race", "behavior_id"]
    },
    {
      "label": "Classification",
      "fields": ["type", "boss", "child"]
    },
    {
      "label": "Combat",
      "fields": ["hp", "tp", "min_damage", "max_damage", "accuracy", "evade", "armor", "return_damage"]
    },
    {
      "label": "Element",
      "fields": ["element", "element_damage", "element_weakness", "element_weakness_damage"]
    },
    {
      "label": "Progression",
      "fields": ["level", "experience"]
    },
    {
      "label": "Rates",
      "description": "Per-NPC cadence overrides loaded by load_npc_rates_file.rs.",
      "fields": ["attack_rate_ms", "move_rate_ms", "reputation_grant"]
    },
    {
      "label": "Drops",
      "description": "Drop table loaded by load_drop_file.rs.",
      "fields": ["drops"]
    },
    {
      "label": "Talk",
      "description": "Ambient lines loaded by load_talk_file.rs.",
      "fields": ["talk_messages", "talk_rate"]
    }
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "graphic_id": { "type": "integer", "minimum": 0 },
    "race": { "type": "integer", "minimum": 0 },
    "boss": { "type": "boolean" },
    "child": { "type": "boolean" },
    "type": {
      "type": "integer",
      "minimum": 0,
      "description": "NpcType enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "Friendly" },
        { "value": 1, "label": "Passive" },
        { "value": 2, "label": "Aggressive" },
        { "value": 6, "label": "Shop" },
        { "value": 7, "label": "Inn" },
        { "value": 9, "label": "Bank" },
        { "value": 10, "label": "Barber" },
        { "value": 11, "label": "Guild" },
        { "value": 12, "label": "Priest" },
        { "value": 13, "label": "Lawyer" },
        { "value": 14, "label": "Trainer" },
        { "value": 15, "label": "Quest" }
      ]
    },
    "behavior_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Behavior id used by shops/inns/skill_masters/etc. to bind to this NPC."
    },
    "hp": { "type": "integer", "minimum": 0 },
    "tp": { "type": "integer", "minimum": 0 },
    "min_damage": { "type": "integer", "minimum": 0 },
    "max_damage": { "type": "integer", "minimum": 0 },
    "accuracy": { "type": "integer" },
    "evade": { "type": "integer" },
    "armor": { "type": "integer" },
    "return_damage": { "type": "integer" },
    "element": {
      "type": "integer",
      "minimum": 0,
      "description": "Element enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "None" },
        { "value": 1, "label": "Light" },
        { "value": 2, "label": "Dark" },
        { "value": 3, "label": "Earth" },
        { "value": 4, "label": "Wind" },
        { "value": 5, "label": "Water" },
        { "value": 6, "label": "Fire" }
      ]
    },
    "element_damage": { "type": "integer", "minimum": 0 },
    "element_weakness": {
      "type": "integer",
      "minimum": 0,
      "description": "Element this NPC is weak to.",
      "x-aio-options": [
        { "value": 0, "label": "None" },
        { "value": 1, "label": "Light" },
        { "value": 2, "label": "Dark" },
        { "value": 3, "label": "Earth" },
        { "value": 4, "label": "Wind" },
        { "value": 5, "label": "Water" },
        { "value": 6, "label": "Fire" }
      ]
    },
    "element_weakness_damage": { "type": "integer", "minimum": 0 },
    "level": { "type": "integer", "minimum": 0 },
    "experience": { "type": "integer", "minimum": 0 },

    "drops": {
      "type": "array",
      "description": "Item drop table (load_drop_file.rs). Empty = NPC drops nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "rate"],
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "x-aio-ref": { "type": "items" }
          },
          "min_amount": { "type": "integer", "minimum": 0 },
          "max_amount": { "type": "integer", "minimum": 0 },
          "rate": {
            "type": "integer",
            "minimum": 0,
            "description": "Drop rate; integer share, NOT a percentage. See GlobalDrops.ron for the divisor."
          }
        }
      }
    },
    "talk_messages": {
      "type": "array",
      "description": "Random ambient lines this NPC speaks (load_talk_file.rs). Empty = silent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "talk_rate": {
      "type": "integer",
      "minimum": 0,
      "description": "Talk chance roll (load_talk_file.rs). 0 with non-empty talk_messages = unused; lift before shipping."
    },

    "attack_rate_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-NPC attack cadence in milliseconds (load_npc_rates_file.rs). Defaults to 1000 if absent."
    },
    "move_rate_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-NPC movement cadence in milliseconds (load_npc_rates_file.rs). Defaults to 1500 if absent."
    },
    "reputation_grant": {
      "type": "integer",
      "description": "Reputation points granted to the killer per kill (load_npc_rates_file.rs). Defaults to 1 if absent."
    }
  }
}
