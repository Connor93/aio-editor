{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aio-editor/schemas/items.json",
  "title": "Item",
  "description": "REOSERV data/pub/items/<id>.json — one EifRecord per file. See src/utils/load_item_file.rs. type/subtype/special/element/size are enum integers; see eolib::protocol::pub.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "x-aio-groups": [
    {
      "label": "Identity",
      "fields": ["name", "graphic_id"]
    },
    {
      "label": "Type",
      "description": "Type/subtype/special control how the item behaves; size controls inventory packing.",
      "fields": ["type", "subtype", "special", "size", "weight"]
    },
    {
      "label": "Combat",
      "fields": ["hp", "tp", "min_damage", "max_damage", "accuracy", "evade", "armor", "return_damage"]
    },
    {
      "label": "Character Stats",
      "layout": "inline",
      "fields": ["str", "intl", "wis", "agi", "con", "cha"]
    },
    {
      "label": "Element",
      "fields": ["element", "element_damage"]
    },
    {
      "label": "Resistances",
      "layout": "inline",
      "fields": ["light_resistance", "dark_resistance", "earth_resistance", "air_resistance", "water_resistance", "fire_resistance"]
    },
    {
      "label": "Type-Specific Specs",
      "description": "spec1/2/3 have meanings that vary by item type — see the loader.",
      "fields": ["spec1", "spec2", "spec3"]
    },
    {
      "label": "Requirements",
      "fields": ["level_requirement", "class_requirement"]
    },
    {
      "label": "Stat Requirements",
      "layout": "inline",
      "fields": ["str_requirement", "int_requirement", "wis_requirement", "agi_requirement", "con_requirement", "cha_requirement"]
    }
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "graphic_id": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "integer",
      "minimum": 0,
      "description": "ItemType enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "General" },
        { "value": 2, "label": "Currency" },
        { "value": 3, "label": "Heal" },
        { "value": 4, "label": "Teleport" },
        { "value": 6, "label": "ExpReward" },
        { "value": 9, "label": "Key" },
        { "value": 10, "label": "Weapon" },
        { "value": 11, "label": "Shield" },
        { "value": 12, "label": "Armor" },
        { "value": 13, "label": "Hat" },
        { "value": 14, "label": "Boots" },
        { "value": 15, "label": "Gloves" },
        { "value": 16, "label": "Accessory" },
        { "value": 17, "label": "Belt" },
        { "value": 18, "label": "Necklace" },
        { "value": 19, "label": "Ring" },
        { "value": 20, "label": "Armlet" },
        { "value": 21, "label": "Bracer" },
        { "value": 22, "label": "Alcohol" },
        { "value": 23, "label": "EffectPotion" },
        { "value": 24, "label": "HairDye" },
        { "value": 25, "label": "CureCurse" }
      ]
    },
    "subtype": {
      "type": "integer",
      "minimum": 0,
      "description": "ItemSubtype enum (eolib)."
    },
    "special": {
      "type": "integer",
      "minimum": 0,
      "description": "ItemSpecial enum (eolib)."
    },
    "hp": { "type": "integer" },
    "tp": { "type": "integer" },
    "min_damage": { "type": "integer", "minimum": 0 },
    "max_damage": { "type": "integer", "minimum": 0 },
    "accuracy": { "type": "integer" },
    "evade": { "type": "integer" },
    "armor": { "type": "integer" },
    "return_damage": { "type": "integer" },
    "str": { "type": "integer" },
    "intl": { "type": "integer" },
    "wis": { "type": "integer" },
    "agi": { "type": "integer" },
    "con": { "type": "integer" },
    "cha": { "type": "integer" },
    "light_resistance": { "type": "integer" },
    "dark_resistance": { "type": "integer" },
    "earth_resistance": { "type": "integer" },
    "air_resistance": { "type": "integer" },
    "water_resistance": { "type": "integer" },
    "fire_resistance": { "type": "integer" },
    "spec1": {
      "type": "integer",
      "description": "Type-dependent: ammo type for weapons, slot for armor, healing amount for consumables, etc."
    },
    "spec2": { "type": "integer", "description": "Type-dependent (see spec1)." },
    "spec3": { "type": "integer", "description": "Type-dependent (see spec1)." },
    "level_requirement": { "type": "integer", "minimum": 0 },
    "class_requirement": {
      "type": "integer",
      "minimum": 0,
      "description": "Required class id; 0 = any class.",
      "x-aio-ref": { "type": "classes", "noneLabel": "(any class)" }
    },
    "str_requirement": { "type": "integer", "minimum": 0 },
    "int_requirement": { "type": "integer", "minimum": 0 },
    "wis_requirement": { "type": "integer", "minimum": 0 },
    "agi_requirement": { "type": "integer", "minimum": 0 },
    "con_requirement": { "type": "integer", "minimum": 0 },
    "cha_requirement": { "type": "integer", "minimum": 0 },
    "element": {
      "type": "integer",
      "minimum": 0,
      "description": "Element enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "None" },
        { "value": 1, "label": "Light" },
        { "value": 2, "label": "Dark" },
        { "value": 3, "label": "Earth" },
        { "value": 4, "label": "Wind" },
        { "value": 5, "label": "Water" },
        { "value": 6, "label": "Fire" }
      ]
    },
    "element_damage": { "type": "integer", "minimum": 0 },
    "weight": { "type": "integer", "minimum": 0 },
    "size": {
      "type": "integer",
      "minimum": 0,
      "description": "ItemSize enum (eolib).",
      "x-aio-options": [
        { "value": 0, "label": "1x1" },
        { "value": 1, "label": "1x2" },
        { "value": 2, "label": "1x3" },
        { "value": 3, "label": "1x4" },
        { "value": 4, "label": "2x1" },
        { "value": 5, "label": "2x2" },
        { "value": 6, "label": "2x3" },
        { "value": 7, "label": "2x4" }
      ]
    }
  }
}
