{
  "name": "@aio-editor/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp -r src/schemas dist/schemas",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "^6.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
