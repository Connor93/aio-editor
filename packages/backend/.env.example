REOSERV_BASE_URL=http://127.0.0.1:8090
PORT=4000
HOST=127.0.0.1
DATABASE_URL=file:./editor.db

# Absolute path to REOSERV's data/pub directory; the editor reads JSON pubs
# from here, writes drafts to <PUB_DATA_DIR>/.staging/, and (Sprint 3.4) will
# atomically copy them back on push-to-live.
PUB_DATA_DIR=/Users/cfraser/Projects/reoserv/data/pub

# Optional. Absolute path to REOSERV's extracted GFX directory. When set,
# /api/gfx/* serves PNGs for the form's GFX preview thumbnails. Layout:
# <GFX_ROOT>/gfx021/<resource_id>.png for NPCs, gfx023 for items,
# gfx024 for spells, gfx025 for spell icons. resource_id = 100 + graphic_id*2.
GFX_ROOT=/Users/cfraser/Projects/reoserv/data/gfx

# Optional. Absolute path to REOSERV's data/maps directory (the origin-maps
# volume in prod). When set, the editor's Maps tab can upload .emf files here;
# REOSERV hot-reloads existing maps. Leave unset to disable map upload.
MAPS_DATA_DIR=/Users/cfraser/Projects/reoserv/data/maps

# Optional. Absolute path to the vendored eomap-js bundled assets served at
# /api/mapper/assets/* for the embedded map editor's Connected Mode. Defaults
# to the assets shipped inside the backend build, so it rarely needs setting.
MAPPER_ASSETS_DIR=
