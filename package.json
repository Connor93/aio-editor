{
  "name": "aio-editor",
  "version": "0.0.0",
  "private": true,
  "description": "All In One Editor — pub authoring tool for the Project Origin REOSERV alpha",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace packages/backend",
    "dev:frontend": "npm run dev --workspace packages/frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:skeletons": "tsx scripts/skeleton-check.ts"
  }
}
